# GitHub user or org that owns the catsed repository (lowercase).
GITHUB_OWNER=your-github-user
# The NAS address on your LAN; catsed listens there on port 8080.
NAS_LAN_IP=192.168.1.10
# What Senders and Receivers type: your *.synology.me hostname behind the router.
CATSED_PUBLIC_URL=https://catsed-you.synology.me
# The nginx LXC container on the router: the only peer allowed to send PROXY headers.
CATSED_TRUSTED_PROXY=192.168.1.2
# Optional global speed limit shared by all Transfers, e.g. 10MiB (bytes per second).
CATSED_MAX_RATE=
